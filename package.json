{
  "name": "gpeek",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build && node apps/cli/dist/index.js",
    "build": "node scripts/build.mjs",
    "lint": "eslint . && prettier --check . && npm run check:boundaries",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:integration && npm run test:e2e",
    "test:ui": "node scripts/e2e.mjs --config playwright.ui.config.mjs"
  },
  "devDependencies": {
    "@types/node": "22.13.17",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/parser": "8.23.0",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "2.1.9",
    "@playwright/test": "1.64.0"
  },
  "bin": {
    "gpeek": "bin/gpeek.mjs"
  }
}
